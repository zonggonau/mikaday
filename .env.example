# ---------- Printful ----------
# Private token (Developers → Your tokens). Store-level token recommended.
PRINTFUL_API_KEY=
# Only for account-level tokens: the store ID to act on.
# PRINTFUL_STORE_ID=
# false = paid orders arrive in Printful as drafts and are confirmed from Admin → Orders.
# true  = paid orders go straight to production (Printful charges your wallet/card immediately).
PRINTFUL_AUTO_CONFIRM=false

# ---------- PayPal (checkout & payment) ----------
# developer.paypal.com → Apps & Credentials. Use the Sandbox app while testing, the Live app in production.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live — must match the client ID / secret above.
PAYPAL_MODE=sandbox
# Webhook ID shown after adding {SITE_URL}/api/paypal/webhook in the PayPal app (PAYMENT.CAPTURE.* events).
PAYPAL_WEBHOOK_ID=

# ---------- Store ----------
NEXT_PUBLIC_SITE_URL=https://mikaday.com
NEXT_PUBLIC_STORE_NAME=MIKADAY
# Must match the currency of your Printful retail prices.
NEXT_PUBLIC_STORE_CURRENCY=USD
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Shown on the Contact page only when set.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Mika's social accounts (Follow Mika section, footer, mobile menu). Leave empty to hide.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# ---------- Customer emails (order confirmed / shipped / delivered) ----------
# Any SMTP provider (Brevo, Resend, Zoho, Hostinger Mail, …). Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender on a domain verified with the provider (SPF + DKIM), e.g. MIKADAY <orders@mikaday.store>
EMAIL_FROM=
# Where customer replies go (defaults to NEXT_PUBLIC_SUPPORT_EMAIL).
EMAIL_REPLY_TO=
# Random string; the scheduler calls /api/cron/orders with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---------- SEO ----------
# Google Search Console → Add property → HTML tag: paste only the content="…" value. Rebuild after changing.
GOOGLE_SITE_VERIFICATION=

# ---------- Database ----------
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dropshiping

# ---------- Security ----------
# Random string used in the Printful webhook URL (?secret=...). Do NOT reuse the API key.
SYNC_WEBHOOK_SECRET=
# Random string (32+ chars) used to sign admin sessions.
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
